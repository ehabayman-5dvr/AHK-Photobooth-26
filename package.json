{
  "name": "ahk-anniversary-photobooth",
  "version": "1.0.0",
  "private": true,
  "description": "AHK Egypt 75th anniversary time-travel photobooth",
  "author": "5DVR",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/check-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop-dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run assets && npm run typecheck && vite build && node scripts/check-production-secrets.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "check:secrets": "node scripts/check-git-secrets.mjs --working",
    "test:e2e": "playwright test",
    "electron:build": "npm run build && node scripts/package-desktop.mjs portable && npm run desktop:seed && npm run desktop:seed -- release/win-unpacked",
    "electron:unpacked": "npm run build && node scripts/package-desktop.mjs unpacked && npm run desktop:seed -- release/win-unpacked",
    "desktop:seed": "node scripts/seed-desktop-config.mjs",
    "icons": "node scripts/create-app-icons.mjs"
  },
  "build": {
    "appId": "com.5dvr.ahk75.photobooth",
    "productName": "AHK 75th Anniversary Photobooth",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "AHK-75-Photobooth-${version}-Portable.exe",
      "signAndEditExecutable": true,
      "icon": "public/icons/app-icon.ico",
      "signExecutable": false
    },
    "extraResources": [
      {
        "from": "release/build-config/operator-defaults.json",
        "to": "operator-defaults.json"
      }
    ]
  },
  "dependencies": {
    "face-api.js": "^0.22.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
